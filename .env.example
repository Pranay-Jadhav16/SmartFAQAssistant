# Smart FAQ Assistant - Environment Configuration
# Secret key for Flask sessions (change in production)
SECRET_KEY=college-smart-faq-assistant-secure-key-2026

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# AI Agent Matching Threshold (0.0 to 1.0)
# A score at or above this threshold returns the matched FAQ.
# Lower scores trigger the department contact fallback response.
FAQ_MATCH_THRESHOLD=0.25

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
